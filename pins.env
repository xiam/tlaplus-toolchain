# The pins of the toolchain image. This file is the only place that holds
# them: `make build` passes each value to the Dockerfile as a build argument.
# Update procedure: docs/PINS.md.
#
# Format: one KEY=value per line, no quotes, no spaces, no trailing comments.
# The file is read both by make (`include`) and by POSIX sh (`.`).

# Base image: Eclipse Temurin JRE 21, pinned by the digest of its multi-platform
# index (linux/amd64 + linux/arm64). BASE_TAG and JRE_VERSION are informational;
# the digest is what the build uses.
BASE_IMAGE=docker.io/library/eclipse-temurin
BASE_TAG=21-jre-noble
BASE_DIGEST=sha256:0d57a8e90c2bb844c5a8e1b2b71e11eff06dad7edcfd803cd21ed4ae203b2515
JRE_VERSION=21.0.13+9

# TLC: tla2tools.jar from the upstream GitHub release, verified by SHA256 at
# build time. Non-prerelease tags only.
TLC_VERSION=1.7.4
TLC_SHA256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
